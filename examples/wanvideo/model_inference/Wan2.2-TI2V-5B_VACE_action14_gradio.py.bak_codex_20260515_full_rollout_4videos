PIPE = None
EPISODE_INFO_CACHE = {}
APP_ARGS = None


def discover_episodes(agx_base, camera_names):
    base = Path(agx_base)
    data_dir = base / "data"
    videos_dir = base / "videos"
    if not data_dir.exists():
        raise FileNotFoundError(f"Data directory not found: {data_dir}")

    episodes = {}
    for parquet_path in sorted(data_dir.glob("chunk-*/episode_*.parquet")):
        m = re.search(r"episode_(\d+)\.parquet$", parquet_path.name)
        if m is None:
            continue
        ep_idx = int(m.group(1))
        chunk = parquet_path.parent.name
        video_paths = {
            cam: videos_dir / chunk / f"observation.images.{cam}" / f"episode_{ep_idx:06d}.mp4"
            for cam in CAMERAS
        }
        if all(video_paths[cam].exists() for cam in camera_names):
            key = f"episode_{ep_idx:06d}@{chunk}"
            episodes[key] = {
                "episode_index": ep_idx,
                "chunk": chunk,
                "parquet_path": parquet_path,
                "video_paths": video_paths,
            }
    if not episodes:
        raise RuntimeError(f"No valid episodes found in {agx_base}")
    return episodes


def load_episode_action(parquet_path):
    table = pq.read_table(parquet_path, columns=["action"])
    return np.asarray(table["action"].to_pylist(), dtype=np.float32)


def get_video_len(path):
    import av

    container = av.open(str(path))
    try:
        stream = next((s for s in container.streams if s.type == "video"), None)
        if stream is None:
            return 0
        if stream.frames is not None and int(stream.frames) > 0:
            return int(stream.frames)
        count = 0
        for _ in container.decode(stream):
            count += 1
        return count
    finally:
        container.close()


def build_episode_info(ep, args):
    action = load_episode_action(ep["parquet_path"])
    n = action.shape[0]
    for cam in args.camera_names:
        n = min(n, get_video_len(ep["video_paths"][cam]))

    if n <= 0:
        raise RuntimeError("Empty episode.")

    ds_idx = np.arange(0, n, args.downsample_step, dtype=np.int64)

    return {
        "episode_index": ep["episode_index"],
        "chunk": ep["chunk"],
        "parquet_path": ep["parquet_path"],
        "video_paths": ep["video_paths"],
        "ds_indices": ds_idx,
        "T_ds": len(ds_idx),
        "action_ds": action[ds_idx],
    }


def get_episode_info(episode_key):
    if episode_key not in EPISODE_INFO_CACHE:
        EPISODE_INFO_CACHE[episode_key] = build_episode_info(APP_ARGS.episodes[episode_key], APP_ARGS)
    return EPISODE_INFO_CACHE[episode_key]


def format_action14(action14):
    vals = list(np.asarray(action14, dtype=np.float32).reshape(14))
    return ", ".join([f"{float(v):.6f}" for v in vals])


def parse_action_text(action_text):
    tokens = action_text.replace("\n", " ").replace(";", " ").replace(",", " ").split()
    vals = [float(x) for x in tokens]
    if len(vals) != 14:
        raise ValueError(f"Action dim must be 14, got {len(vals)}")
    return np.asarray(vals, dtype=np.float32)


def load_ref_multiview_frame(ep_info, ds_pos):
    raw_idx = int(ep_info["ds_indices"][ds_pos])
    frames = []
    raw_hw = None
    for cam in APP_ARGS.camera_names:
        frame = read_video_rgb_by_indices(ep_info["video_paths"][cam], [raw_idx])[0]
        if raw_hw is None:
            raw_hw = frame.shape[:2]
        frame = np.array(Image.fromarray(frame).resize((APP_ARGS.view_width, APP_ARGS.view_height), Image.BILINEAR))
        frames.append(frame)
    return Image.fromarray(np.concatenate(frames, axis=0)), raw_hw


def _arm_chain_points(joints, state_unit):
    joints = np.asarray(joints, dtype=np.float64)
    if state_unit == "deg":
        joints = np.deg2rad(joints)
    points = []
    T = np.eye(4, dtype=np.float64)
    points.append(T[:3, 3].copy())
    q_idx = 0
    for joint in _get_chain():
        T = T @ _make_transform(_rpy_to_rot(joint.origin_rpy), joint.origin_xyz)
        points.append(T[:3, 3].copy())
        if joint.joint_type in ("revolute", "continuous"):
            T = T @ _make_transform(_axis_angle_to_rot(joint.axis_xyz, joints[q_idx]), np.zeros(3, dtype=np.float64))
            q_idx += 1
            points.append(T[:3, 3].copy())
    return np.stack(points, axis=0)


def _transform_points(T, pts):
    pts_h = np.concatenate([pts, np.ones((pts.shape[0], 1), dtype=pts.dtype)], axis=1)
    return (T @ pts_h.T).T[:, :3]


def render_robot_preview(action14):
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    action14 = np.asarray(action14, dtype=np.float32)
    left_pts = _arm_chain_points(action14[0:6], APP_ARGS.fk_state_unit)
    right_pts = _arm_chain_points(action14[7:13], APP_ARGS.fk_state_unit)
    right_pts = _transform_points(APP_ARGS.extr["T_br2bl"], right_pts)

    left_tip = make_ee_pose_from_action(action14[None, :])[0, 0:3]
    right_tip = make_ee_pose_from_action(action14[None, :])[0, 7:10]
    right_tip = _transform_points(APP_ARGS.extr["T_br2bl"], right_tip[None, :])[0]

    all_pts = np.concatenate([left_pts, right_pts, left_tip[None], right_tip[None]], axis=0)
    center = all_pts.mean(axis=0)
    span = max(float(np.ptp(all_pts[:, 0])), float(np.ptp(all_pts[:, 1])), float(np.ptp(all_pts[:, 2])), 0.4)
    half = span * 0.65

    fig = plt.figure(figsize=(5, 4), dpi=140)
    ax = fig.add_subplot(111, projection="3d")
    ax.plot(left_pts[:, 0], left_pts[:, 1], left_pts[:, 2], "-o", color="#2b8a3e", linewidth=3, markersize=4, label="left")
    ax.plot(right_pts[:, 0], right_pts[:, 1], right_pts[:, 2], "-o", color="#c92a2a", linewidth=3, markersize=4, label="right")
    ax.scatter([left_tip[0]], [left_tip[1]], [left_tip[2]], color="#74b816", s=60)
    ax.scatter([right_tip[0]], [right_tip[1]], [right_tip[2]], color="#f03e3e", s=60)
    ax.set_xlim(center[0] - half, center[0] + half)
    ax.set_ylim(center[1] - half, center[1] + half)
    ax.set_zlim(center[2] - half, center[2] + half)
    ax.set_xlabel("x")
    ax.set_ylabel("y")
    ax.set_zlabel("z")
    ax.view_init(elev=25, azim=-55)
    ax.legend(loc="upper left")
    ax.set_title("ARXX5 FK preview")
    fig.tight_layout()
    buf = io.BytesIO()
    fig.savefig(buf, format="png")
    plt.close(fig)
    buf.seek(0)
    return Image.open(buf).convert("RGB")


def build_action_controls(action_text, raw_hw):
    user_action = parse_action_text(action_text)
    action_seq = np.repeat(user_action[None, :], APP_ARGS.num_frames, axis=0)
    fk_ee_pose_seq = make_ee_pose_from_action(action_seq)
    traj_actions_by_cam, traj_w2c_by_cam = make_per_camera_sequences(
        fk_ee_pose_seq, action_seq, APP_ARGS.extr, APP_ARGS.camera_axis_mode
    )
    ray_w2c_by_cam = make_center_ray_w2c_sequences(fk_ee_pose_seq, APP_ARGS.extr, APP_ARGS.camera_axis_mode)

    raw_h, raw_w = raw_hw

    intrinsics = get_color_intrinsics()
    control_per_cam = {}
    ray_o_per_cam = {}
    ray_d_per_cam = {}

    for cam in APP_ARGS.camera_names:
        k = scale_intrinsic(intrinsics[cam], raw_h, raw_w, APP_ARGS.view_height, APP_ARGS.view_width)

        control_per_cam[cam] = generate_traj_map(
            traj_actions_by_cam[cam],
            traj_w2c_by_cam[cam],
            k,
            APP_ARGS.view_height,
            APP_ARGS.view_width,
            radius=APP_ARGS.traj_radius,
            radius_mode=APP_ARGS.traj_radius_mode,
            min_radius=APP_ARGS.traj_min_radius,
            max_radius=APP_ARGS.traj_max_radius,
            ref_depth=APP_ARGS.traj_ref_depth,
            near_depth=APP_ARGS.traj_near_depth,
            far_depth=APP_ARGS.traj_far_depth,
        )

        ray_o_seq = []
        ray_d_seq = []
        for t in range(APP_ARGS.num_frames):
            c2w = np.linalg.inv(ray_w2c_by_cam[cam][t]).astype(np.float32)
            ro, rd = generate_raymap(k, c2w, APP_ARGS.view_height, APP_ARGS.view_width)
            ray_o_seq.append(to_uint8_img(ro, APP_ARGS.ray_o_vmin, APP_ARGS.ray_o_vmax))
            ray_d_seq.append(to_uint8_img(rd, APP_ARGS.ray_d_vmin, APP_ARGS.ray_d_vmax))
        ray_o_per_cam[cam] = ray_o_seq
        ray_d_per_cam[cam] = ray_d_seq

    control_video = []
    ray_map_o = []
    ray_map_d = []
    for t in range(APP_ARGS.num_frames):
        control_video.append(
            Image.fromarray(np.concatenate([control_per_cam[cam][t] for cam in APP_ARGS.camera_names], axis=0))
        )
        ray_map_o.append(
            Image.fromarray(np.concatenate([ray_o_per_cam[cam][t] for cam in APP_ARGS.camera_names], axis=0))
        )
        ray_map_d.append(
            Image.fromarray(np.concatenate([ray_d_per_cam[cam][t] for cam in APP_ARGS.camera_names], axis=0))
        )

    robot_preview = render_robot_preview(user_action)
    return control_video, ray_map_o, ray_map_d, robot_preview, format_action14(user_action)


def save_frames_to_mp4(frames, path, fps):
    import imageio.v2 as imageio

    writer = imageio.get_writer(path, fps=fps)
    try:
        for frame in frames:
            writer.append_data(np.array(frame))
    finally:
        writer.close()


def load_pipe(base_model_paths, vace_model_path, device, vace_in_dim=144):
    import torch

    from diffsynth.models.utils import load_state_dict
    from diffsynth.models.wan_video_vace_wan22_codex import VaceWan22CodexModel
    from diffsynth.pipelines.wan_video_new_wan22_codex import ModelConfig, WanVideoPipeline

    model_configs = [ModelConfig(path=path) for path in base_model_paths]
    pipe = WanVideoPipeline.from_pretrained(
        torch_dtype=torch.bfloat16,
        device=device,
        model_configs=model_configs,
    )
    if vace_model_path:
        if getattr(pipe, "vace", None) is None:
            pipe.vace = VaceWan22CodexModel(vace_in_dim=vace_in_dim).to(dtype=pipe.torch_dtype, device=pipe.device)
        state_dict = load_state_dict(vace_model_path)
        if any(name.startswith("vace_global_") for name in state_dict):
            pipe.vace.enable_global_cross_attn(global_context_dim=16)
        pipe.vace.load_state_dict(state_dict)
    return pipe


def get_pipe():
    global PIPE
    if PIPE is None:
        PIPE = load_pipe(APP_ARGS.base_model_paths, APP_ARGS.vace_model_path, APP_ARGS.device, APP_ARGS.vace_in_dim)
    return PIPE


def load_init_episode(episode_key):
    ep_info = get_episode_info(episode_key)
    init_action = ep_info["action_ds"][0]
    action_text = format_action14(init_action)
    ref_frame, raw_hw = load_ref_multiview_frame(ep_info, 0)
    control_video, ray_map_o, ray_map_d, robot_preview, _ = build_action_controls(action_text, raw_hw)
    status = (
        f"episode={episode_key}\n"
        "context_step=0\n"
        f"future_frames={APP_ARGS.predict_frames}\n"
        "action format: 14 dims = left6 + left gripper + right6 + right gripper\n"
        "traj_source=fk_action\n"
        "context reset to episode init frame"
    )

    ref_np = np.array(ref_frame)
    return (
        action_text,
        ref_np,
        np.array(control_video[0]),
        np.array(ray_map_o[0]),
        np.array(ray_map_d[0]),
        np.array(robot_preview),
        None,
        None,
        None,
        None,
        None,
        status,
        ref_np,
        tuple(int(x) for x in raw_hw),
        0,
    )


def run_generation(action_text, seed, steps, cfg_scale, context_state, raw_hw_state, step_state):
    if context_state is None or raw_hw_state is None:
        raise RuntimeError("Please click Load Init Action first.")

    ref_frame = Image.fromarray(np.asarray(context_state, dtype=np.uint8))
    control_video, ray_map_o, ray_map_d, robot_preview, normalized_action = build_action_controls(
        action_text, tuple(raw_hw_state)
    )

    pipe = get_pipe()
    total_h = APP_ARGS.view_height * len(APP_ARGS.camera_names)
    generated = pipe(
        prompt=APP_ARGS.prompt,
        input_image=ref_frame,
        vace_video=control_video,
        ray_map_o=ray_map_o,
        ray_map_d=ray_map_d,
        height=total_h,
        width=APP_ARGS.view_width,
        num_frames=APP_ARGS.num_frames,
        num_inference_steps=int(steps),
        cfg_scale=float(cfg_scale),
        seed=int(seed),
        tiled=APP_ARGS.tiled,
    )
    generated = [x if isinstance(x, Image.Image) else Image.fromarray(np.array(x)) for x in generated]

    control_future = control_video[1:]
    ray_o_future = ray_map_o[1:]
    ray_d_future = ray_map_d[1:]
    generated_future = generated[1:]
    next_context = generated_future[-1] if generated_future else ref_frame

    out_dir = os.path.join(tempfile.gettempdir(), "wan22_arxx5_gradio")
    os.makedirs(out_dir, exist_ok=True)
    token = uuid.uuid4().hex[:10]
    control_path = os.path.join(out_dir, f"{token}_control_future.mp4")
    ray_o_path = os.path.join(out_dir, f"{token}_ray_o_future.mp4")
    ray_d_path = os.path.join(out_dir, f"{token}_ray_d_future.mp4")
    gen_path = os.path.join(out_dir, f"{token}_generated_future.mp4")

    save_frames_to_mp4(control_future, control_path, APP_ARGS.fps)
    save_frames_to_mp4(ray_o_future, ray_o_path, APP_ARGS.fps)
    save_frames_to_mp4(ray_d_future, ray_d_path, APP_ARGS.fps)
    save_frames_to_mp4(generated_future, gen_path, APP_ARGS.fps)

    status = (
        f"done\n"
        f"context_step={int(step_state) + len(generated_future)}\n"
        f"future_generated_frames={len(generated_future)}\n"
        f"seed={seed}, steps={steps}, cfg={cfg_scale}\n"
        "context updated to the last generated frame"
    )

    first_generated = np.array(generated_future[0]) if generated_future else None
    next_context_np = np.array(next_context)
    return (
        next_context_np,
        np.array(control_video[0]),
        np.array(ray_map_o[0]),
        np.array(ray_map_d[0]),
        np.array(robot_preview),
        first_generated,
        control_path,
        ray_o_path,
        ray_d_path,
        gen_path,
        normalized_action,
        status,
        next_context_np,
        int(step_state) + len(generated_future),
    )


def build_demo():
    episode_keys = sorted(APP_ARGS.episodes.keys())
    default_episode = episode_keys[0]
    ep_info = get_episode_info(default_episode)
    init_action = ep_info["action_ds"][0]
    default_action_text = format_action14(init_action)

    with gr.Blocks(title="Wan2.2 ARXX5 Online Inference") as demo:
        gr.Markdown(
            "# Wan2.2 TI2V-5B + VACE (ARXX5) Action-14 Online Inference\n"
            "选择 episode 初始化第一帧和初始 14 维 action；之后每次点击 Generate 都会用当前 context 和输入 action 自回归生成后 8 帧，并把最后一帧作为下一次 context。"
        )

        episode_dropdown = gr.Dropdown(choices=episode_keys, value=default_episode, label="Episode")

        action_text = gr.Textbox(
            label="Action (14 dims: left6 + left gripper + right6 + right gripper)",
            value=default_action_text,
            lines=3,
        )

        with gr.Row():
            seed_slider = gr.Slider(minimum=0, maximum=1000000, step=1, value=APP_ARGS.seed, label="Seed")
            step_slider = gr.Slider(minimum=1, maximum=100, step=1, value=APP_ARGS.num_inference_steps, label="Steps")
            cfg_slider = gr.Slider(minimum=1.0, maximum=12.0, step=0.1, value=APP_ARGS.cfg_scale, label="CFG")

        with gr.Row():
            load_btn = gr.Button("Load Init Action / Reset Context", variant="secondary")
            run_btn = gr.Button("Generate 8 Future Frames", variant="primary")

        with gr.Row():
            ref_image = gr.Image(label="Reference Frame", type="numpy")
            control_preview = gr.Image(label="Traj Map Preview", type="numpy")
            robot_preview = gr.Image(label="Approx Robot (URDF FK)", type="numpy")

        with gr.Row():
            ray_o_preview = gr.Image(label="Ray Map O Preview", type="numpy")
            ray_d_preview = gr.Image(label="Ray Map D Preview", type="numpy")
            first_generated = gr.Image(label="Generated Three-View First Future Frame", type="numpy")

        with gr.Row():
            control_video = gr.Video(label="Traj Map Video (future frames)")
            ray_o_video = gr.Video(label="Ray Map O Video (future frames)")
            ray_d_video = gr.Video(label="Ray Map D Video (future frames)")
            gen_video = gr.Video(label="Generated Three-View Video (future frames)")

        status = gr.Textbox(label="Status", lines=8)
        context_state = gr.State()
        raw_hw_state = gr.State()
        step_state = gr.State(0)

        load_outputs = [
            action_text,
            ref_image,
            control_preview,
            ray_o_preview,
            ray_d_preview,
            robot_preview,
            first_generated,
            control_video,
            ray_o_video,
            ray_d_video,
            gen_video,
            status,
            context_state,
            raw_hw_state,
            step_state,
        ]
        load_btn.click(load_init_episode, inputs=[episode_dropdown], outputs=load_outputs)
        episode_dropdown.change(load_init_episode, inputs=[episode_dropdown], outputs=load_outputs)

        run_btn.click(
            run_generation,
            inputs=[action_text, seed_slider, step_slider, cfg_slider, context_state, raw_hw_state, step_state],
            outputs=[
                ref_image,
                control_preview,
                ray_o_preview,
                ray_d_preview,
                robot_preview,
                first_generated,
                control_video,
                ray_o_video,
                ray_d_video,
                gen_video,
                action_text,
                status,
                context_state,
                step_state,
            ],
        )

        init_vals = load_init_episode(default_episode)
        demo.load(
            lambda: init_vals,
            outputs=load_outputs,
        )

    return demo


def parse_args():
